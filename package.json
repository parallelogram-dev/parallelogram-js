{
  "name": "@parallelogram-js/core",
  "version": "0.4.1",
  "description": "A lightweight, enhancement-first JavaScript framework for progressive web applications",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && rollup -c && node scripts/build-css.mjs",
    "build:demo": "rollup -c rollup.demo.config.js && node scripts/build-css.mjs demo",
    "demo": "npm run build:demo && serve demo -l 3000",
    "site": "vite --config site/vite.config.js",
    "build:site": "vite build --config site/vite.config.js",
    "preview:site": "vite preview --config site/vite.config.js",
    "check:exports": "node scripts/check-exports.mjs",
    "check:package": "publint --strict",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest --project unit",
    "coverage": "vitest run --project unit --coverage",
    "prepack": "npm run build"
  },
  "keywords": [
    "parallelogram-js",
    "framework",
    "progressive-enhancement"
  ],
  "license": "MIT",
  "sideEffects": [
    "./src/components/P*.js",
    "./dist/components/P*.js",
    "./dist/dev/components/P*.js",
    "*.css"
  ],
  "exports": {
    ".": {
      "development": "./dist/dev/index.js",
      "default": "./dist/index.js"
    },
    "./components/*.js": {
      "development": "./dist/dev/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./components/*": {
      "development": "./dist/dev/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./adapters/*.js": {
      "development": "./dist/dev/adapters/*.js",
      "default": "./dist/adapters/*.js"
    },
    "./adapters/*": {
      "development": "./dist/dev/adapters/*.js",
      "default": "./dist/adapters/*.js"
    },
    "./core/*.js": {
      "development": "./dist/dev/core/*.js",
      "default": "./dist/core/*.js"
    },
    "./core/*": {
      "development": "./dist/dev/core/*.js",
      "default": "./dist/core/*.js"
    },
    "./managers/*.js": {
      "development": "./dist/dev/managers/*.js",
      "default": "./dist/managers/*.js"
    },
    "./managers/*": {
      "development": "./dist/dev/managers/*.js",
      "default": "./dist/managers/*.js"
    },
    "./dev/components/*.js": "./dist/dev/components/*.js",
    "./dev/components/*": "./dist/dev/components/*.js",
    "./dev/adapters/*.js": "./dist/dev/adapters/*.js",
    "./dev/adapters/*": "./dist/dev/adapters/*.js",
    "./dev/core/*.js": "./dist/dev/core/*.js",
    "./dev/core/*": "./dist/dev/core/*.js",
    "./styles": "./dist/styles/index.min.css",
    "./styles/*.css": "./dist/styles/components/*.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/demo",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "directories": {
    "test": "test"
  },
  "browserslist": [
    "baseline 2023"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.3 || ^24.15.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "cssnano": "^9.0.4",
    "eslint": "^10.10.0",
    "eslint-plugin-compat": "^7.0.2",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "rollup": "^4.63.2",
    "sass": "^1.104.1",
    "serve": "^14.2.6",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parallelogram-dev/parallelogram-js.git"
  },
  "author": "PeptoLab"
}
