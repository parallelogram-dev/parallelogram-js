    "adapters/tiktok-pixel.js": 1082,
    "core/BaseComponent.js": 2642,
    "core/ComponentHost.js": 2589,
    "core/ComponentRegistry.js": 930,
    "core/ComponentStates.js": 498,
    "core/DevLogger.js": 590,
    "core/FragmentSwapper.js": 4230,
    "core/Parallelogram.js": 12989,
